<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gamerwingman.app"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- Minimum API level 31 (Android 12) -->
    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="34" />

    <!-- Internet access for Firebase, OAuth, API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone for voice input (wake word detection + speech recognition) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera for potential future avatar customization -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Read/write to persistent data path for avatar caching -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Android 12+ runtime permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Text-to-Speech access -->
    <uses-permission android:name="android.permission.ACCESS_VOICE_CALL_STATE" />

    <!-- Biometric authentication (optional future feature) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Background task for mood tracking -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Query available packages (for platform integration) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:debuggable="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="false">

        <!-- Main activity -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase configuration (will be populated by Firebase plugin) -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- OAuth redirect activity for platform integrations -->
        <activity
            android:name="com.gamerwingman.auth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Steam OAuth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth-callback"
                    android:scheme="gamerwingman" />
            </intent-filter>
            <!-- Epic Games OAuth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="epic-callback"
                    android:scheme="gamerwingman" />
            </intent-filter>
        </activity>

        <!-- Background job for inactivity tracking -->
        <service
            android:name="com.gamerwingman.services.MoodTrackerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Receiver for system boot to restart mood tracking -->
        <receiver
            android:name="com.gamerwingman.receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Content provider for file sharing (if needed) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.gamerwingman.app.fileprovider"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
